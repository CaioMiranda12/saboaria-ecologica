generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

enum ProductType {
  BAR
  PASTE
  LIQUID
  POWDER
  SOAP
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique
  mainName            String
  complementName      String?
  shortDescription    String
  fullDescription     String
  weight              String?
  type                ProductType
  ingredients         String[]
  variants            String[]
  usageInstructions   String?
  badge               String?
  isFeatured          Boolean     @default(false)
  isPublished         Boolean     @default(true)
  displayOrder        Int         @default(0)
  hasFragranceOptions Boolean     @default(false)
  hasSizeOptions      Boolean     @default(false)
  imageUrl            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("products")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  initials  String
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model Partnership {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("partnerships")
}

model SiteContent {
  id          String   @id @default("singleton")
  mission     String
  vision      String
  values      String
  description String
  foundedYear String
  whatsapp    String
  instagram   String
  email       String
  linkedin    String
  address     String
  updatedAt   DateTime @updatedAt

  @@map("site_content")
}


// Conteúdo estruturado do CMS. Uma página contém seções ordenáveis.
model CmsPage {
  id        String       @id @default(cuid())
  slug      String       @unique
  title     String
  sections  CmsSection[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("cms_pages")
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  title     String
  position  Int      @default(0)
  enabled   Boolean  @default(true)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, position])
  @@map("cms_sections")
}


model MediaAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  filename  String
  mimeType  String
  bytes     Int
  width     Int?
  height    Int?
  altText   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}
