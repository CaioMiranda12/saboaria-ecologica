generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  role         AdminRole @default(ADMIN)
  passwordHash String
  sessionVersion Int @default(0)
  emailFactor Boolean @default(false)
  emailOtpHash String?
  emailOtpUntil DateTime?
  emailOtpSent DateTime?
  emailOtpAttempts Int @default(0)
  emailOtpVersion Int?
  emailOtpPurpose String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

enum ProductType {
  BAR
  PASTE
  LIQUID
  POWDER
  SOAP
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique
  mainName            String
  complementName      String?
  shortDescription    String
  fullDescription     String
  weight              String?
  type                ProductType
  ingredients         String[]
  variants            String[]
  usageInstructions   String?
  badge               String?
  isFeatured          Boolean     @default(false)
  isPublished         Boolean     @default(true)
  displayOrder        Int         @default(0)
  hasFragranceOptions Boolean     @default(false)
  hasSizeOptions      Boolean     @default(false)
  imageUrl            String?
  purchaseUrl         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("products")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  initials  String
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model Partnership {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("partnerships")
}

model SiteContent {
  id          String   @id @default("singleton")
  mission     String
  vision      String
  values      String
  description String
  foundedYear String
  whatsapp    String
  instagram   String
  email       String
  linkedin    String
  address     String
  updatedAt   DateTime @updatedAt

  @@map("site_content")
}


// Conteúdo estruturado do CMS. Uma página contém seções ordenáveis.
model CmsPage {
  id        String       @id @default(cuid())
  slug      String       @unique
  title     String
  sections  CmsSection[]
  publication CmsPublication?
  versions CmsVersion[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("cms_pages")
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  title     String
  position  Int      @default(0)
  enabled   Boolean  @default(true)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, position])
  @@map("cms_sections")
}


model MediaAsset {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  filename  String
  mimeType  String
  bytes     Int
  width     Int?
  height    Int?
  altText   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}

// Conteúdo publicado, separado do rascunho em cms_sections.
model CmsPublication {
  id String @id @default(cuid())
  pageId String @unique
  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sections Json
  publishedAt DateTime @default(now())
  @@map("cms_publications")
}

model CmsVersion {
  id String @id @default(cuid())
  pageId String
  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sections Json
  createdAt DateTime @default(now())
  actorId String?
  actorName String?
  actorEmail String?
  action String @default("PUBLISH")
  sourceVersionId String?
  @@index([pageId, createdAt])
  @@map("cms_versions")
}

// Auditoria administrativa: não armazena senhas, tokens ou conteúdo sensível.
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  actorEmail String
  actorName String
  action String
  resource String
  resourceId String?
  changes Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([resource, resourceId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model LoginAttempt {
  key String @id
  failures Int @default(0)
  blockedUntil DateTime?
  updatedAt DateTime @updatedAt
  @@map("login_attempts")
}

model PasswordResetToken {
  id String @id @default(cuid())
  adminId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([adminId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PageSeo {
  path String @id
  title String
  description String
  imageUrl String @default("")
  updatedAt DateTime @updatedAt
  @@map("page_seo")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  address     String
  description String   @default("")
  latitude    Float
  longitude   Float
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("locations")
}
